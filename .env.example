# Site
PUBLIC_SITE_URL=https://www.armenderoian.dev

# SvelteKit CSRF origin (required in production / Docker).
# Must exactly match how you open the site in the browser.
# Local Docker default: http://localhost:8080
# Production: https://www.armenderoian.dev
ORIGIN=http://localhost:8080

# Contact form (required for form submission)
CONTACT_FORM_TO_EMAIL=
CONTACT_FORM_FROM_EMAIL=
CONTACT_FORM_SUBJECT_PREFIX=[Website]

# SMTP (optional — uses nodemailer defaults when host is set)
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USERNAME=
CONTACT_SMTP_PASSWORD=
CONTACT_SMTP_ENCRYPTION=tls

# Data directory (defaults to ./data in project root)
# DATA_DIR=/app/data

# Admin area (server-only; required for /admin login)
# Generate a long random secret, e.g. `openssl rand -hex 32`
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
