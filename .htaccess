# Apache (mod_rewrite). If the site lives in a subdirectory, set RewriteBase to match
# (e.g. RewriteBase /mysite/) and set BASE_PATH in includes/config.php to the same path.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # App routes before -f/-d so /projects keeps using root projects.php even if projects/ exists (dev shim).
    RewriteRule ^$ index.php [L]
    RewriteRule ^projects/?$ projects.php [L]
    RewriteRule ^project/([^/]+)/?$ project.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

DirectoryIndex index.php
