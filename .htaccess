Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve real files and directories first (CSS, assets, projects/index.php shim, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Pretty routes (must come after the rule above)
    RewriteRule ^$ index.php [L]
    RewriteRule ^admin(?:/.*)?$ admin.php [L,QSA]
    RewriteRule ^projects/?$ projects.php [L]
    RewriteRule ^blog/?$ blog.php [L]
    RewriteRule ^blog/([^/]+)/?$ blog_post.php?slug=$1 [L,QSA]
    RewriteRule ^project/([^/]+)/?$ project.php?slug=$1 [L,QSA]
</IfModule>

DirectoryIndex index.php
